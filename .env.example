# Публичный адрес сайта (без слэша в конце). На Vercel можно не задавать - возьмётся автоматически,
# но для своего домена лучше указать явно.
SITE_URL=https://your-site.vercel.app

# Crypto Pay (@CryptoBot в Telegram): Crypto Pay -> Create App -> API Token
CRYPTOPAY_TOKEN=

# Админка: пароль и секрет подписи cookie (длинная случайная строка)
ADMIN_PASSWORD=
SESSION_SECRET=

# База: Upstash Redis (в Vercel: Storage -> Marketplace -> Upstash Redis). Переменные подставятся сами.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Необязательно: ссылка на скачивание скрипта и контакт поддержки
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Необязательно: уведомления о новых обращениях в Telegram
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=
